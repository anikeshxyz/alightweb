<%- include('header', { path: '/orders', admin: admin, title: 'Order Fulfillment & Management' }) %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
            <i class="fas fa-circle-check"></i>
            <span><%= success %></span>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="fas fa-circle-exclamation"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <!-- Header Section -->
    <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h2 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em; color: var(--secondary-color); margin-bottom: 0.35rem;">
                Order Fulfillment
            </h2>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0;">
                Track orders, update delivery status, and review customer shipping manifests.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/admin/orders/export" class="btn btn-secondary">
                <i class="fas fa-file-arrow-down"></i> Export Orders CSV
            </a>
        </div>
    </div>

    <!-- Status Filter Tabs -->
    <div class="filter-tabs">
        <a href="/admin/orders" class="filter-chip <%= currentStatus === 'all' ? 'active' : '' %>">
            <span>All Orders</span>
            <span class="chip-count"><%= counts ? counts.all : 0 %></span>
        </a>
        <a href="/admin/orders?status=Processing" class="filter-chip <%= currentStatus === 'Processing' ? 'active' : '' %>">
            <span>Processing</span>
            <span class="chip-count"><%= counts ? counts.Processing : 0 %></span>
        </a>
        <a href="/admin/orders?status=Shipped" class="filter-chip <%= currentStatus === 'Shipped' ? 'active' : '' %>">
            <span>Shipped</span>
            <span class="chip-count"><%= counts ? counts.Shipped : 0 %></span>
        </a>
        <a href="/admin/orders?status=Delivered" class="filter-chip <%= currentStatus === 'Delivered' ? 'active' : '' %>">
            <span>Delivered</span>
            <span class="chip-count"><%= counts ? counts.Delivered : 0 %></span>
        </a>
        <a href="/admin/orders?status=Cancelled" class="filter-chip <%= currentStatus === 'Cancelled' ? 'active' : '' %>">
            <span>Cancelled</span>
            <span class="chip-count"><%= counts ? counts.Cancelled : 0 %></span>
        </a>
    </div>

    <!-- Search Toolbar -->
    <div class="card" style="padding: 1.25rem 1.5rem; margin-bottom: 1.5rem;">
        <form action="/admin/orders" method="GET" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
            <input type="hidden" name="status" value="<%= currentStatus %>">
            
            <div class="search-input-group" style="flex: 1; min-width: 280px;">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" name="q" class="form-control" placeholder="Search by Order ID, customer name, email, or city..." value="<%= typeof currentQuery !== 'undefined' ? currentQuery : '' %>">
            </div>

            <button type="submit" class="btn btn-secondary">
                <i class="fas fa-search"></i> Search
            </button>

            <% if (currentQuery && currentQuery.trim()) { %>
                <a href="/admin/orders?status=<%= currentStatus %>" class="btn btn-sm" style="color: var(--text-muted); background: #f1f5f9;">
                    <i class="fas fa-xmark"></i> Clear Search
                </a>
            <% } %>
        </form>
    </div>

    <!-- Orders Table Card -->
    <div class="card" style="padding: 0; overflow: hidden;">
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th style="padding-left: 1.75rem;">Order &amp; Items</th>
                        <th>Customer</th>
                        <th>Delivery Destination</th>
                        <th>Payment</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th style="text-align: right; padding-right: 1.75rem;">Update Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <tr>
                                <!-- Order & Items Thumbnail Preview -->
                                <td style="padding-left: 1.75rem;">
                                    <div style="font-family: 'Space Mono', monospace; font-weight: 700; color: var(--secondary-color); font-size: 0.9rem; margin-bottom: 0.35rem;">
                                        #<%= order._id.toString().substring(18) %>
                                    </div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    </div>

                                    <!-- Item Thumbnails -->
                                    <div style="display: flex; gap: 6px; flex-wrap: wrap; max-width: 180px;">
                                        <% if (order.orderItems && order.orderItems.length > 0) { %>
                                            <% order.orderItems.forEach(item => { %>
                                                <div style="width: 38px; height: 38px; border-radius: 6px; overflow: hidden; border: 1px solid var(--border-color); background: #fff;" title="<%= item.name %> (Qty: <%= item.qty %>)">
                                                    <img src="<%= item.image || '/images/placeholder.jpg' %>" alt="<%= item.name %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/placeholder.jpg'">
                                                </div>
                                            <% }) %>
                                        <% } %>
                                    </div>
                                </td>

                                <!-- Customer Info -->
                                <td>
                                    <div style="font-weight: 700; color: var(--secondary-color); font-size: 0.92rem;">
                                        <%= order.user ? order.user.name : 'Guest User' %>
                                    </div>
                                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.15rem;">
                                        <%= order.user ? order.user.email : 'N/A' %>
                                    </div>
                                    <% if (order.user && order.user.mobile) { %>
                                        <div style="font-size: 0.78rem; color: var(--text-muted);">
                                            <i class="fas fa-phone" style="font-size: 0.7rem;"></i> <%= order.user.mobile %>
                                        </div>
                                    <% } %>
                                </td>

                                <!-- Shipping Address -->
                                <td>
                                    <% const addr = order.shippingAddress || {}; %>
                                    <div style="font-size: 0.85rem; color: var(--secondary-color); font-weight: 600;">
                                        <%= addr.city ? `${addr.city}, ${addr.state || ''}` : 'Address Provided' %>
                                    </div>
                                    <div style="font-size: 0.78rem; color: var(--text-muted); max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= `${addr.street || ''}, ${addr.city || ''}, ${addr.state || ''} ${addr.zipCode || ''} ${addr.country || ''}` %>">
                                        <%= addr.street || '' %> <%= addr.zipCode || '' %>
                                    </div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">
                                        <%= addr.country || 'India' %>
                                    </div>
                                </td>

                                <!-- Payment Method & Status -->
                                <td>
                                    <div style="font-weight: 600; font-size: 0.85rem; color: var(--secondary-color); text-transform: uppercase;">
                                        <%= order.paymentMethod || 'COD' %>
                                    </div>
                                    <% if (order.isPaid) { %>
                                        <span style="display: inline-flex; align-items: center; gap: 0.3rem; color: #059669; font-size: 0.75rem; font-weight: 700; background: #ecfdf5; padding: 0.15rem 0.45rem; border-radius: 4px; margin-top: 0.25rem;">
                                            <i class="fas fa-check-circle"></i> Paid
                                        </span>
                                    <% } else { %>
                                        <span style="display: inline-flex; align-items: center; gap: 0.3rem; color: #d97706; font-size: 0.75rem; font-weight: 700; background: #fffbeb; padding: 0.15rem 0.45rem; border-radius: 4px; margin-top: 0.25rem;">
                                            <i class="fas fa-clock"></i> Pending
                                        </span>
                                    <% } %>
                                </td>

                                <!-- Total Amount -->
                                <td>
                                    <strong style="font-size: 1.05rem; color: var(--secondary-color); font-weight: 800;">
                                        ₹<%= (order.totalPrice || 0).toLocaleString('en-IN') %>
                                    </strong>
                                </td>

                                <!-- Current Status Badge -->
                                <td>
                                    <% let badgeClass = 'badge-processing';
                                       if (order.status === 'Shipped') badgeClass = 'badge-shipped';
                                       if (order.status === 'Delivered') badgeClass = 'badge-delivered';
                                       if (order.status === 'Cancelled') badgeClass = 'badge-cancelled';
                                    %>
                                    <span class="badge <%= badgeClass %>">
                                        <span class="badge-dot"></span>
                                        <%= order.status %>
                                    </span>
                                </td>

                                <!-- Status Changer Form -->
                                <td style="text-align: right; padding-right: 1.75rem;">
                                    <form action="/admin/orders/<%= order._id %>/status" method="POST" style="display: flex; gap: 0.5rem; justify-content: flex-end; align-items: center;">
                                        <select name="status" class="form-control" style="width: auto; padding: 0.45rem 0.75rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
                                            <option value="Processing" <%= order.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                                            <option value="Shipped" <%= order.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                            <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                            <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary btn-icon" title="Save Status Change">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 4.5rem 1rem;">
                                <div style="width: 70px; height: 70px; background: #f8fafc; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">
                                    <i class="fas fa-box-open" style="font-size: 2.25rem; color: #cbd5e1;"></i>
                                </div>
                                <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 0.35rem;">No orders match this criteria</h3>
                                <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">Try changing your filter tabs or searching with different terms.</p>
                                <a href="/admin/orders" class="btn btn-secondary">View All Orders</a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

<%- include('footer') %>