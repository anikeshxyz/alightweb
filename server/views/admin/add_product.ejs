<%- include('header', { path: '/products', admin: admin, title: 'Add New Product' }) %>

    <div style="margin-bottom: 1.5rem;">
        <a href="/admin/products" style="color: var(--text-muted); font-weight: 600; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-arrow-left"></i> Back to Product Catalog
        </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="fas fa-circle-exclamation"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
            <i class="fas fa-circle-check"></i>
            <span>Product added successfully!</span>
        </div>
    <% } %>

    <div class="card" style="max-width: 900px; margin: 0 auto;">
        <div class="card-header">
            <div>
                <h2 class="card-title" style="font-size: 1.4rem;">Add New Product</h2>
                <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Fill in details, specifications, and media assets for this product.</p>
            </div>
        </div>

        <form action="/admin/products/add" method="POST" enctype="multipart/form-data" id="addProductForm">
            <!-- Section 1: Basic Information -->
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-info-circle" style="color: var(--primary-color);"></i> 1. Basic Information
            </h3>

            <div class="form-group">
                <label>Product Title <span style="color: #ef4444;">*</span></label>
                <input type="text" name="name" class="form-control" required placeholder="e.g. Heavy-Duty Tall Pantry Pull-Out Unit (6-Tier)">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Primary Category <span style="color: #ef4444;">*</span></label>
                    <select name="category" id="categorySelect" class="form-control" required style="cursor: pointer;">
                        <option value="" disabled selected>— Select a category —</option>
                        <option value="modular-kitchen">Modular Kitchen Accessories</option>
                        <option value="kitchen-storage">Kitchen Storage &amp; Organization</option>
                        <option value="tabletop-cutlery">Tabletop &amp; Cutlery Products</option>
                        <option value="bathroom-fixtures">Bathroom Fixtures &amp; Accessories</option>
                        <option value="wardrobe-accessories">Wardrobe Accessories &amp; Storage</option>
                        <option value="wire-products">Wire Products &amp; Home Furnishings</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Sub-Category</label>
                    <select name="subCategory" id="subCategorySelect" class="form-control" style="cursor: pointer;">
                        <option value="">— Select category first —</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Full Description <span style="color: #ef4444;">*</span></label>
                <textarea name="description" class="form-control" rows="4" required placeholder="Detailed description of features, construction, and functionality..."></textarea>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border-color); margin: 2rem 0;">

            <!-- Section 2: Pricing & Inventory -->
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-tag" style="color: var(--primary-color);"></i> 2. Pricing &amp; Stock
            </h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Original MRP / Retail Price (₹)</label>
                    <input type="number" name="originalPrice" id="originalPriceInput" class="form-control" step="1" placeholder="e.g. 24999">
                    <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">Leave blank if no discount applied.</small>
                </div>

                <div class="form-group">
                    <label>Selling Price (₹) <span style="color: #ef4444;">*</span></label>
                    <input type="number" name="price" id="sellingPriceInput" class="form-control" step="1" required placeholder="e.g. 18499">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Discount Label</label>
                    <input type="text" name="discount" id="discountInput" class="form-control" placeholder="e.g. 26% OFF (auto-calculated if empty)">
                </div>

                <div class="form-group">
                    <label>Initial Stock Quantity <span style="color: #ef4444;">*</span></label>
                    <input type="number" name="countInStock" class="form-control" required min="0" placeholder="e.g. 50">
                </div>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border-color); margin: 2rem 0;">

            <!-- Section 3: Product Specifications -->
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-sliders" style="color: var(--primary-color);"></i> 3. Specifications &amp; Details
            </h3>

            <div class="form-group">
                <label>Material &amp; Finish</label>
                <input type="text" name="material" class="form-control" placeholder="e.g. SS 304 Grade Stainless Steel & Chrome Finish">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Dimensions</label>
                    <input type="text" name="dimensions" class="form-control" placeholder="e.g. 450mm W × 500mm D × 1900mm H">
                </div>

                <div class="form-group">
                    <label>Components Included</label>
                    <input type="text" name="components" class="form-control" placeholder="e.g. 1× Main Frame, 6× Heavy Wire Baskets, 1× Slide Set">
                </div>
            </div>

            <div class="form-group">
                <label>Eco-Friendly / Sustainability Features</label>
                <textarea name="ecoFeatures" class="form-control" rows="3" placeholder="Enter one feature per line, e.g:&#10;100% Recyclable Marine-Grade Steel&#10;Corrosion Resistant Zero VOC Finish&#10;Lead-free chrome passivation"></textarea>
                <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">Each line will render as a distinct bullet point on the product details page.</small>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Country of Origin</label>
                    <input type="text" name="countryOfOrigin" class="form-control" value="India" placeholder="e.g. India">
                </div>

                <div class="form-group">
                    <label>Artisan / Manufacturing Photo URL</label>
                    <input type="url" name="artisanImageUrl" class="form-control" placeholder="https://... (photo of craftsperson or workshop)">
                </div>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border-color); margin: 2rem 0;">

            <!-- Section 4: Media & Image Gallery -->
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-images" style="color: var(--primary-color);"></i> 4. Media &amp; Product Gallery
            </h3>

            <div class="form-group">
                <label>Upload Images from Device</label>
                <div style="border: 2px dashed var(--border-color); border-radius: 0.85rem; padding: 2rem 1.5rem; text-align: center; background: #fafafa; position: relative;">
                    <i class="fas fa-cloud-arrow-up" style="font-size: 2.25rem; color: var(--primary-color); margin-bottom: 0.75rem; display: block;"></i>
                    <p style="font-weight: 600; margin-bottom: 0.25rem; color: var(--secondary-color);">Drag &amp; drop images here or click to browse</p>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1rem;">Supports JPG, PNG, WEBP up to 10MB each</p>
                    <input type="file" name="images" id="imageUploadInput" multiple accept="image/*" style="position: absolute; inset: 0; opacity: 0; cursor: pointer;">
                </div>
                <div id="fileUploadSummary" style="margin-top: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--primary-dark); display: none;"></div>
            </div>

            <div class="form-group">
                <label>Or Enter Direct Image URLs (one per line)</label>
                <textarea name="imageUrls" class="form-control" rows="3" placeholder="https://images.unsplash.com/...&#10;https://drive.google.com/file/d/..."></textarea>
                <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">Supports Unsplash, Google Drive share links (auto-converted), and direct image URLs.</small>
            </div>

            <!-- Submit Buttons -->
            <div style="margin-top: 2.5rem; display: flex; gap: 1rem; justify-content: flex-end;">
                <a href="/admin/products" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary" id="saveProductBtn" style="padding: 0.85rem 2rem;">
                    <i class="fas fa-check"></i> Create Product
                </button>
            </div>
        </form>
    </div>

    <!-- Category / SubCategory Dynamic Mapper Script -->
    <script>
        const subCategoryMap = {
            'modular-kitchen': [
                'pantry-pull-outs', 'kitchen-baskets', 'cutlery-holders-stands',
                'plate-stands', 'bottle-racks', 'spice-racks',
                'cylinder-trolleys', 'rolling-pin-holders', 'corner-units',
                'waste-bins', 'multipurpose-baskets'
            ],
            'kitchen-storage': [
                'shelves', 'organizers', 'trays', 'pull-out-systems', 'magic-corners'
            ],
            'tabletop-cutlery': [
                'spoon-stands', 'cup-holders', 'cup-stands', 'napkin-holders', 'cutlery-stands', 'bowls-and-stands'
            ],
            'bathroom-fixtures': [
                'towel-racks', 'corner-caddies', 'soap-holders', 'robe-hooks'
            ],
            'wardrobe-accessories': [
                'wardrobe-racks', 'trouser-organizers', 'storage-accessories'
            ],
            'wire-products': [
                'wire-racks', 'wire-organizers', 'utility-wire-baskets'
            ],
        };

        const categorySelect = document.getElementById('categorySelect');
        const subCategorySelect = document.getElementById('subCategorySelect');

        function populateSubCategories(cat) {
            subCategorySelect.innerHTML = '';
            const subs = subCategoryMap[cat] || [];
            if (!cat || subs.length === 0) {
                subCategorySelect.innerHTML = '<option value="">— No subcategories —</option>';
                return;
            }
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = '— Select subcategory —';
            subCategorySelect.appendChild(placeholder);
            subs.forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.textContent = sub.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
                subCategorySelect.appendChild(opt);
            });
        }

        categorySelect.addEventListener('change', () => populateSubCategories(categorySelect.value));

        // Auto discount calculation
        const mrpInput = document.getElementById('originalPriceInput');
        const spInput = document.getElementById('sellingPriceInput');
        const discInput = document.getElementById('discountInput');

        function updateAutoDiscount() {
            const mrp = parseFloat(mrpInput.value);
            const sp = parseFloat(spInput.value);
            if (mrp && sp && mrp > sp && !discInput.value) {
                const pct = Math.round(((mrp - sp) / mrp) * 100);
                discInput.placeholder = `${pct}% OFF (auto)`;
            }
        }

        mrpInput.addEventListener('input', updateAutoDiscount);
        spInput.addEventListener('input', updateAutoDiscount);

        // File upload counter summary
        const imageUploadInput = document.getElementById('imageUploadInput');
        const fileUploadSummary = document.getElementById('fileUploadSummary');

        imageUploadInput.addEventListener('change', () => {
            if (imageUploadInput.files && imageUploadInput.files.length > 0) {
                fileUploadSummary.style.display = 'block';
                fileUploadSummary.innerHTML = `<i class="fas fa-paperclip"></i> ${imageUploadInput.files.length} file(s) selected for upload.`;
            } else {
                fileUploadSummary.style.display = 'none';
            }
        });
    </script>

<%- include('footer') %>