<%- include('header', { path: '/products', admin: admin, title: 'Edit Product' }) %>

    <div style="margin-bottom: 1.5rem;">
        <a href="/admin/products" style="color: var(--text-muted); font-weight: 600; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-arrow-left"></i> Back to Product Catalog
        </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="fas fa-circle-exclamation"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <div class="card" style="max-width: 900px; margin: 0 auto;">
        <div class="card-header">
            <div>
                <h2 class="card-title" style="font-size: 1.4rem;">Edit Product: <%= product.name %></h2>
                <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0.2rem 0 0 0;">Update details, pricing, inventory, and gallery assets.</p>
            </div>
            <a href="/admin/products/delete/<%= product._id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this product permanently?')">
                <i class="fas fa-trash-can"></i> Delete
            </a>
        </div>

        <form action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data" id="editProductForm">
            <!-- Section 1: Basic Information -->
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-info-circle" style="color: var(--primary-color);"></i> 1. Basic Information
            </h3>

            <div class="form-group">
                <label>Product Title <span style="color: #ef4444;">*</span></label>
                <input type="text" name="name" class="form-control" required value="<%= product.name %>">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Primary Category <span style="color: #ef4444;">*</span></label>
                    <select name="category" id="categorySelect" class="form-control" required style="cursor: pointer;">
                        <option value="modular-kitchen" <%= product.category === 'modular-kitchen' ? 'selected' : '' %>>Modular Kitchen Accessories</option>
                        <option value="kitchen-storage" <%= product.category === 'kitchen-storage' ? 'selected' : '' %>>Kitchen Storage &amp; Organization</option>
                        <option value="tabletop-cutlery" <%= product.category === 'tabletop-cutlery' ? 'selected' : '' %>>Tabletop &amp; Cutlery Products</option>
                        <option value="bathroom-fixtures" <%= product.category === 'bathroom-fixtures' ? 'selected' : '' %>>Bathroom Fixtures &amp; Accessories</option>
                        <option value="wardrobe-accessories" <%= product.category === 'wardrobe-accessories' ? 'selected' : '' %>>Wardrobe Accessories &amp; Storage</option>
                        <option value="wire-products" <%= product.category === 'wire-products' ? 'selected' : '' %>>Wire Products &amp; Home Furnishings</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Sub-Category</label>
                    <select name="subCategory" id="subCategorySelect" class="form-control" style="cursor: pointer;">
                        <!-- Dynamically populated -->
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Full Description <span style="color: #ef4444;">*</span></label>
                <textarea name="description" class="form-control" rows="4" required><%= product.description %></textarea>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border-color); margin: 2rem 0;">

            <!-- Section 2: Pricing & Inventory -->
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-tag" style="color: var(--primary-color);"></i> 2. Pricing &amp; Stock
            </h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Original MRP / Retail Price (₹)</label>
                    <input type="number" name="originalPrice" id="originalPriceInput" class="form-control" step="1" value="<%= product.originalPrice || '' %>">
                </div>

                <div class="form-group">
                    <label>Selling Price (₹) <span style="color: #ef4444;">*</span></label>
                    <input type="number" name="price" id="sellingPriceInput" class="form-control" step="1" required value="<%= product.price %>">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Discount Label</label>
                    <input type="text" name="discount" id="discountInput" class="form-control" value="<%= product.discount || '' %>" placeholder="e.g. 25% OFF">
                </div>

                <div class="form-group">
                    <label>Count In Stock <span style="color: #ef4444;">*</span></label>
                    <input type="number" name="countInStock" class="form-control" required min="0" value="<%= product.countInStock %>">
                </div>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border-color); margin: 2rem 0;">

            <!-- Section 3: Product Specifications -->
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-sliders" style="color: var(--primary-color);"></i> 3. Specifications &amp; Details
            </h3>

            <div class="form-group">
                <label>Material &amp; Finish</label>
                <input type="text" name="material" class="form-control" value="<%= product.material || '' %>">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Dimensions</label>
                    <input type="text" name="dimensions" class="form-control" value="<%= product.dimensions || '' %>">
                </div>

                <div class="form-group">
                    <label>Components Included</label>
                    <input type="text" name="components" class="form-control" value="<%= product.components || '' %>">
                </div>
            </div>

            <div class="form-group">
                <label>Eco-Friendly Features</label>
                <textarea name="ecoFeatures" class="form-control" rows="3"><%= product.ecoFeatures || '' %></textarea>
                <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">Each line appears as a distinct bullet point on the live store.</small>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                <div class="form-group">
                    <label>Country of Origin</label>
                    <input type="text" name="countryOfOrigin" class="form-control" value="<%= product.countryOfOrigin || 'India' %>">
                </div>

                <div class="form-group">
                    <label>Artisan / Workshop Photo URL</label>
                    <input type="url" name="artisanImageUrl" class="form-control" value="<%= product.artisanImage || '' %>">
                </div>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border-color); margin: 2rem 0;">

            <!-- Section 4: Existing Images & Media Gallery -->
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--secondary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-images" style="color: var(--primary-color);"></i> 4. Media &amp; Product Gallery
            </h3>

            <!-- Existing Gallery Manager -->
            <div class="form-group">
                <label>Current Gallery Images (<span id="activeImageCount"><%= (product.images || []).length %></span> total)</label>
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.75rem;">Click the <i class="fas fa-xmark" style="color: #ef4444;"></i> button on any thumbnail to remove that image from this product.</p>

                <div class="gallery-grid" id="existingGalleryGrid">
                    <% if (product.images && product.images.length > 0) { %>
                        <% product.images.forEach((img, idx) => { %>
                            <div class="gallery-thumb-item" id="thumb-<%= idx %>">
                                <img src="<%= img %>" alt="Product Image" onerror="this.src='/images/placeholder.jpg'">
                                <input type="hidden" name="existingImagesToKeep" value="<%= img %>" id="input-thumb-<%= idx %>">
                                <button type="button" class="gallery-thumb-remove" onclick="removeImage(<%= idx %>)" title="Remove this image">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">No images currently attached.</p>
                    <% } %>
                </div>
            </div>

            <!-- Upload Additional Images -->
            <div class="form-group" style="margin-top: 1.5rem;">
                <label>Upload Additional Images from Device</label>
                <div style="border: 2px dashed var(--border-color); border-radius: 0.85rem; padding: 1.5rem; text-align: center; background: #fafafa; position: relative;">
                    <i class="fas fa-cloud-arrow-up" style="font-size: 1.75rem; color: var(--primary-color); margin-bottom: 0.5rem; display: block;"></i>
                    <p style="font-weight: 600; margin-bottom: 0.2rem; font-size: 0.9rem; color: var(--secondary-color);">Drag &amp; drop images or browse</p>
                    <input type="file" name="images" id="imageUploadInput" multiple accept="image/*" style="position: absolute; inset: 0; opacity: 0; cursor: pointer;">
                </div>
                <div id="fileUploadSummary" style="margin-top: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--primary-dark); display: none;"></div>
            </div>

            <!-- Add More Image URLs -->
            <div class="form-group">
                <label>Add More Image URLs (one per line)</label>
                <textarea name="imageUrls" class="form-control" rows="3" placeholder="https://..."></textarea>
            </div>

            <!-- Submit Controls -->
            <div style="margin-top: 2.5rem; display: flex; gap: 1rem; justify-content: flex-end;">
                <a href="/admin/products" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary" style="padding: 0.85rem 2rem;">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>

    <!-- Script for Dynamic Subcategories and Gallery Management -->
    <script>
        const subCategoryMap = {
            'modular-kitchen': [
                'pantry-pull-outs', 'kitchen-baskets', 'cutlery-holders-stands',
                'plate-stands', 'bottle-racks', 'spice-racks',
                'cylinder-trolleys', 'rolling-pin-holders', 'corner-units',
                'waste-bins', 'multipurpose-baskets'
            ],
            'kitchen-storage': [
                'shelves', 'organizers', 'trays', 'pull-out-systems', 'magic-corners'
            ],
            'tabletop-cutlery': [
                'spoon-stands', 'cup-holders', 'cup-stands', 'napkin-holders', 'cutlery-stands', 'bowls-and-stands'
            ],
            'bathroom-fixtures': [
                'towel-racks', 'corner-caddies', 'soap-holders', 'robe-hooks'
            ],
            'wardrobe-accessories': [
                'wardrobe-racks', 'trouser-organizers', 'storage-accessories'
            ],
            'wire-products': [
                'wire-racks', 'wire-organizers', 'utility-wire-baskets'
            ],
        };

        const currentSub = "<%= product.subCategory || '' %>";
        const categorySelect = document.getElementById('categorySelect');
        const subCategorySelect = document.getElementById('subCategorySelect');

        function populateSubCategories(cat, selectedVal) {
            subCategorySelect.innerHTML = '';
            const subs = subCategoryMap[cat] || [];
            if (!cat || subs.length === 0) {
                subCategorySelect.innerHTML = '<option value="">— No subcategories —</option>';
                return;
            }
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = '— Select subcategory —';
            subCategorySelect.appendChild(placeholder);
            subs.forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.textContent = sub.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
                if (selectedVal && sub === selectedVal) opt.selected = true;
                subCategorySelect.appendChild(opt);
            });
        }

        categorySelect.addEventListener('change', () => populateSubCategories(categorySelect.value, null));
        // Init on load with existing subcategory
        populateSubCategories(categorySelect.value, currentSub);

        // Remove single image from existing gallery
        function removeImage(index) {
            const thumb = document.getElementById('thumb-' + index);
            const input = document.getElementById('input-thumb-' + index);
            if (thumb && input) {
                input.value = '';
                thumb.style.opacity = '0.3';
                thumb.style.filter = 'grayscale(100%)';
                thumb.querySelector('.gallery-thumb-remove').style.display = 'none';
            }
        }

        // File upload summary
        const imageUploadInput = document.getElementById('imageUploadInput');
        const fileUploadSummary = document.getElementById('fileUploadSummary');

        imageUploadInput.addEventListener('change', () => {
            if (imageUploadInput.files && imageUploadInput.files.length > 0) {
                fileUploadSummary.style.display = 'block';
                fileUploadSummary.innerHTML = `<i class="fas fa-paperclip"></i> ${imageUploadInput.files.length} file(s) selected for upload.`;
            } else {
                fileUploadSummary.style.display = 'none';
            }
        });
    </script>

<%- include('footer') %>