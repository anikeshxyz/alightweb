<%- include('header', { path: '/dashboard', admin: admin, title: 'Store Analytics & Overview' }) %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
            <i class="fas fa-circle-check"></i>
            <span><%= success %></span>
        </div>
    <% } %>

    <!-- Header Section -->
    <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h2 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em; color: var(--secondary-color); margin-bottom: 0.35rem;">
                Store Performance
            </h2>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0;">
                Real-time operational metrics, sales trends, and order fulfillment.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/admin/orders/export" class="btn btn-secondary">
                <i class="fas fa-file-arrow-down"></i> Export Orders CSV
            </a>
            <a href="/admin/products/add" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Product
            </a>
        </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="card-grid">
        <div class="stat-card">
            <div class="stat-icon icon-green">
                <i class="fas fa-indian-rupee-sign"></i>
            </div>
            <div class="stat-details">
                <h3>Total Revenue</h3>
                <div class="value">₹<%= (totalSales || 0).toLocaleString('en-IN') %></div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-blue">
                <i class="fas fa-bag-shopping"></i>
            </div>
            <div class="stat-details">
                <h3>Total Orders</h3>
                <div class="value"><%= orderCount || 0 %></div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-orange">
                <i class="fas fa-boxes-stacked"></i>
            </div>
            <div class="stat-details">
                <h3>Products In Catalog</h3>
                <div class="value"><%= productCount || 0 %></div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-purple">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-details">
                <h3>Registered Users</h3>
                <div class="value"><%= userCount || 0 %></div>
            </div>
        </div>
    </div>

    <!-- Analytics & Activity Section -->
    <div style="display: grid; grid-template-columns: 2fr 1.1fr; gap: 1.75rem; margin-bottom: 2rem;">
        <!-- Sales Chart Card -->
        <div class="card" style="margin-bottom: 0;">
            <div class="card-header">
                <div>
                    <h3 class="card-title">Revenue Trajectory</h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0.2rem 0 0 0;">Recent 7-day revenue overview</p>
                </div>
                <span class="badge" style="background: #ecfdf5; color: #065f46; font-size: 0.8rem;">
                    <i class="fas fa-arrow-trend-up"></i> Live Tracking
                </span>
            </div>
            <div style="position: relative; height: 260px; width: 100%;">
                <canvas id="salesChart"></canvas>
            </div>
        </div>

        <!-- Quick Summary & Actions Card -->
        <div class="card" style="margin-bottom: 0; display: flex; flex-direction: column;">
            <div class="card-header">
                <h3 class="card-title">Quick Actions</h3>
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 0.85rem; flex: 1;">
                <a href="/admin/products/add" style="display: flex; align-items: center; gap: 1rem; padding: 0.85rem 1rem; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 0.75rem; color: var(--text-main); font-weight: 600;">
                    <div style="width: 36px; height: 36px; border-radius: 0.5rem; background: var(--primary-light); color: var(--primary-dark); display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-plus"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 0.9rem;">Add New Product</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 400;">Publish a new item to catalog</div>
                    </div>
                    <i class="fas fa-chevron-right" style="color: var(--text-muted); font-size: 0.8rem;"></i>
                </a>

                <a href="/admin/orders" style="display: flex; align-items: center; gap: 1rem; padding: 0.85rem 1rem; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 0.75rem; color: var(--text-main); font-weight: 600;">
                    <div style="width: 36px; height: 36px; border-radius: 0.5rem; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-list-check"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 0.9rem;">Fulfill Orders</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 400;">Update shipping & status</div>
                    </div>
                    <i class="fas fa-chevron-right" style="color: var(--text-muted); font-size: 0.8rem;"></i>
                </a>

                <a href="/admin/products/export" style="display: flex; align-items: center; gap: 1rem; padding: 0.85rem 1rem; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 0.75rem; color: var(--text-main); font-weight: 600;">
                    <div style="width: 36px; height: 36px; border-radius: 0.5rem; background: #fef3c7; color: #d97706; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-file-csv"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 0.9rem;">Download Inventory CSV</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 400;">Backup full product inventory</div>
                    </div>
                    <i class="fas fa-chevron-right" style="color: var(--text-muted); font-size: 0.8rem;"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Orders & Inventory Alerts -->
    <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 1.75rem;">
        <!-- Recent Orders Table -->
        <div class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 1.5rem 1.75rem 1rem; display: flex; justify-content: space-between; align-items: center;">
                <h3 class="card-title" style="margin: 0;">Recent Orders</h3>
                <a href="/admin/orders" class="btn btn-sm btn-secondary">View All Orders</a>
            </div>

            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentOrders && recentOrders.length > 0) { %>
                            <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td>
                                        <a href="/admin/orders?q=<%= order._id %>" style="font-family: 'Space Mono', monospace; font-weight: 700; color: var(--primary-color);">
                                            #<%= order._id.toString().substring(18) %>
                                        </a>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600; color: var(--secondary-color); font-size: 0.9rem;">
                                            <%= order.user ? order.user.name : 'Guest Customer' %>
                                        </div>
                                        <div style="font-size: 0.75rem; color: var(--text-muted);">
                                            <%= new Date(order.createdAt).toLocaleDateString() %>
                                        </div>
                                    </td>
                                    <td>
                                        <strong style="color: var(--secondary-color);">₹<%= (order.totalPrice || 0).toLocaleString('en-IN') %></strong>
                                    </td>
                                    <td>
                                        <% let badgeClass = 'badge-processing';
                                           if (order.status === 'Shipped') badgeClass = 'badge-shipped';
                                           if (order.status === 'Delivered') badgeClass = 'badge-delivered';
                                           if (order.status === 'Cancelled') badgeClass = 'badge-cancelled';
                                        %>
                                        <span class="badge <%= badgeClass %>">
                                            <span class="badge-dot"></span>
                                            <%= order.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
                                    <i class="fas fa-inbox" style="font-size: 2rem; opacity: 0.3; display: block; margin-bottom: 0.5rem;"></i>
                                    No orders placed yet.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Low Stock Inventory Alerts -->
        <div class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 1.5rem 1.75rem 1rem; display: flex; justify-content: space-between; align-items: center;">
                <h3 class="card-title" style="margin: 0;">Stock Watchlist</h3>
                <a href="/admin/products?stock=low_stock" class="btn btn-sm btn-secondary">Filter Catalog</a>
            </div>

            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Stock</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (lowStockProducts && lowStockProducts.length > 0) { %>
                            <% lowStockProducts.forEach(prod => { %>
                                <tr>
                                    <td>
                                        <div style="font-weight: 600; font-size: 0.88rem; color: var(--secondary-color); max-width: 170px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= prod.name %>">
                                            <%= prod.name %>
                                        </div>
                                        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: capitalize;">
                                            <%= prod.category ? prod.category.replace(/-/g, ' ') : 'General' %>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (prod.countInStock <= 0) { %>
                                            <span class="badge badge-stock-out">Out of stock</span>
                                        <% } else { %>
                                            <span class="badge badge-stock-low"><%= prod.countInStock %> left</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align: right;">
                                        <a href="/admin/products/edit/<%= prod._id %>" class="btn btn-sm btn-secondary" style="padding: 0.35rem 0.65rem;">
                                            <i class="fas fa-pen-to-square"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
                                    <i class="fas fa-check-double" style="color: var(--primary-color); font-size: 1.75rem; margin-bottom: 0.5rem; display: block;"></i>
                                    All inventory levels are healthy!
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Chart.js Script for Live Sales Trajectory -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const ctx = document.getElementById('salesChart').getContext('2d');
            const labels = <%- chartLabels %>;
            const dataValues = <%- chartValues %>;

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Sales (₹)',
                        data: dataValues,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.08)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' Revenue: ₹' + Number(context.raw).toLocaleString('en-IN');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { borderDash: [4, 4], color: '#f1f5f9' },
                            ticks: {
                                callback: function(value) { return '₹' + value.toLocaleString('en-IN'); },
                                font: { family: 'Outfit', size: 11 }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Outfit', size: 11 } }
                        }
                    }
                }
            });
        });
    </script>

<%- include('footer') %>