<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'Admin Portal' %> - Alight International</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h2 class="auth-title">Admin Portal</h2>
            <p class="auth-subtitle">Secure access to Alight Enterprise Management.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger">
                <i class="fas fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                <span><%= message %></span>
            </div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label>Administrator Email</label>
                <div class="search-input-group">
                    <i class="fas fa-envelope"></i>
                    <input type="email" name="email" class="form-control" required placeholder="admin@example.com" value="admin@example.com">
                </div>
            </div>

            <div class="form-group">
                <label>Password</label>
                <div class="search-input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password" class="form-control" required placeholder="••••••••" value="admin123">
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.5rem;">
                <span>Sign In &amp; Send OTP</span>
                <i class="fas fa-arrow-right"></i>
            </button>
        </form>

        <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 0.85rem 1rem; margin-top: 1.5rem; font-size: 0.82rem; color: var(--text-muted); text-align: center;">
            <i class="fas fa-key" style="color: var(--primary-color);"></i> <b>Default Demo Login:</b> <code style="font-weight: 700; color: var(--secondary-color);">admin@example.com</code> / <code style="font-weight: 700; color: var(--secondary-color);">admin123</code>
        </div>

        <% if (!adminExists) { %>
            <div class="auth-footer">
                <span style="color: var(--text-muted); font-size: 0.9rem;">Initial setup required?</span>
                <a href="/admin/signup" class="auth-link" style="margin-left: 0.4rem;">Create Super Admin</a>
            </div>
        <% } %>
    </div>
</body>
</html>