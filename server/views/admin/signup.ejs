<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'Create Admin Account' %> - Alight International</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon" style="background: #eff6ff; color: #2563eb;">
                <i class="fas fa-user-plus"></i>
            </div>
            <h2 class="auth-title">Create Admin</h2>
            <p class="auth-subtitle">Register your initial enterprise administrator account.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger">
                <i class="fas fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/admin/signup" method="POST">
            <div class="form-group">
                <label>Administrator Email</label>
                <div class="search-input-group">
                    <i class="fas fa-envelope"></i>
                    <input type="email" name="email" class="form-control" required placeholder="admin@example.com">
                </div>
            </div>

            <div class="form-group">
                <label>Master Password (min 6 chars)</label>
                <div class="search-input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password" class="form-control" required minlength="6" placeholder="••••••••">
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.5rem;">
                <span>Create Admin &amp; Verify</span>
                <i class="fas fa-arrow-right"></i>
            </button>
        </form>

        <div class="auth-footer">
            <span style="color: var(--text-muted); font-size: 0.9rem;">Already configured?</span>
            <a href="/admin/login" class="auth-link" style="margin-left: 0.4rem;">Sign in here</a>
        </div>
    </div>
</body>
</html>