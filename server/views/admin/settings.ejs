<%- include('header', { path: '/settings', admin: admin, title: 'Admin Settings & Security' }) %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
            <i class="fas fa-circle-check"></i>
            <span><%= success %></span>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="fas fa-circle-exclamation"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <!-- Header Section -->
    <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em; color: var(--secondary-color); margin-bottom: 0.35rem;">
            Security &amp; System Settings
        </h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0;">
            Manage administrator credentials, security preferences, and system health.
        </p>
    </div>

    <div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.75rem; align-items: start;">
        <!-- Change Password Card -->
        <div class="card">
            <div class="card-header">
                <div>
                    <h3 class="card-title">Change Password</h3>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0.2rem 0 0 0;">Update your administrator account password.</p>
                </div>
            </div>

            <form action="/admin/settings/change-password" method="POST">
                <div class="form-group">
                    <label>Current Password <span style="color: #ef4444;">*</span></label>
                    <div style="position: relative;">
                        <input type="password" name="currentPassword" class="form-control" required placeholder="Enter current password">
                    </div>
                </div>

                <div class="form-group">
                    <label>New Password <span style="color: #ef4444;">*</span></label>
                    <input type="password" name="newPassword" class="form-control" required minlength="6" placeholder="At least 6 characters">
                </div>

                <div class="form-group">
                    <label>Confirm New Password <span style="color: #ef4444;">*</span></label>
                    <input type="password" name="confirmPassword" class="form-control" required minlength="6" placeholder="Repeat new password">
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 0.5rem;">
                    <i class="fas fa-key"></i> Update Password
                </button>
            </form>
        </div>

        <!-- Account Info & System Overview Card -->
        <div style="display: flex; flex-direction: column; gap: 1.75rem;">
            <!-- Admin Profile Details -->
            <div class="card" style="margin-bottom: 0;">
                <div class="card-header">
                    <h3 class="card-title">Administrator Profile</h3>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="display: flex; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted); font-size: 0.9rem;">Email Address</span>
                        <strong style="color: var(--secondary-color); font-size: 0.9rem;"><%= admin.email %></strong>
                    </div>

                    <div style="display: flex; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted); font-size: 0.9rem;">Access Role</span>
                        <span class="badge" style="background: #ecfdf5; color: #065f46; font-size: 0.8rem;">
                            <i class="fas fa-shield-check"></i> Super Administrator
                        </span>
                    </div>

                    <div style="display: flex; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted); font-size: 0.9rem;">2FA Authentication</span>
                        <span style="color: #059669; font-weight: 700; font-size: 0.85rem;">
                            <i class="fas fa-lock"></i> Enabled (Email OTP)
                        </span>
                    </div>

                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted); font-size: 0.9rem;">Session Status</span>
                        <span style="color: #059669; font-weight: 700; font-size: 0.85rem;">
                            <i class="fas fa-circle-dot" style="font-size: 0.6rem;"></i> Active
                        </span>
                    </div>
                </div>
            </div>

            <!-- System Diagnostic Stats -->
            <div class="card" style="margin-bottom: 0;">
                <div class="card-header">
                    <h3 class="card-title">System Metrics</h3>
                </div>

                <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.88rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Database</span>
                        <strong style="color: #059669;"><i class="fas fa-database"></i> MongoDB Atlas Connected</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Products in DB</span>
                        <strong style="color: var(--secondary-color);"><%= productCount %> items</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Orders in DB</span>
                        <strong style="color: var(--secondary-color);"><%= orderCount %> orders</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Customers in DB</span>
                        <strong style="color: var(--secondary-color);"><%= userCount %> users</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

<%- include('footer') %>
