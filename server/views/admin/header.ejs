<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'Admin Portal' %> - Alight International</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <!-- Sidebar Navigation -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-layer-group"></i>
            <div>
                <h2>Alight Admin</h2>
                <span style="font-size: 0.72rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Enterprise Suite</span>
            </div>
        </div>

        <nav class="nav-menu">
            <a href="/admin/dashboard" class="nav-link <%= typeof path !== 'undefined' && path === '/dashboard' ? 'active' : '' %>">
                <i class="fas fa-chart-pie"></i>
                <span>Dashboard</span>
            </a>
            <a href="/admin/products" class="nav-link <%= typeof path !== 'undefined' && path === '/products' ? 'active' : '' %>">
                <i class="fas fa-boxes-stacked"></i>
                <span>Products</span>
            </a>
            <a href="/admin/orders" class="nav-link <%= typeof path !== 'undefined' && path === '/orders' ? 'active' : '' %>">
                <i class="fas fa-bag-shopping"></i>
                <span>Orders</span>
            </a>
            <a href="/admin/users" class="nav-link <%= typeof path !== 'undefined' && path === '/users' ? 'active' : '' %>">
                <i class="fas fa-users-gear"></i>
                <span>Customers</span>
            </a>
            <a href="/admin/settings" class="nav-link <%= typeof path !== 'undefined' && path === '/settings' ? 'active' : '' %>">
                <i class="fas fa-sliders"></i>
                <span>Settings</span>
            </a>

            <div style="margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
                <a href="/" target="_blank" class="nav-link" style="color: var(--text-muted); margin-bottom: 0.25rem;">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    <span>View Live Store</span>
                </a>
                <a href="/admin/logout" class="nav-link nav-link-danger">
                    <i class="fas fa-right-from-bracket"></i>
                    <span>Sign Out</span>
                </a>
            </div>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <main class="main-content">
        <!-- Top Sticky Header -->
        <header class="top-header">
            <div style="display: flex; align-items: center; gap: 1.25rem;">
                <button class="mobile-menu-toggle" id="menuToggleBtn" aria-label="Toggle Navigation">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="header-greeting">
                    <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.15rem;">
                        Admin Portal
                    </span>
                    <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--secondary-color); margin: 0;">
                        <%= (typeof admin !== 'undefined' && admin && admin.email) ? admin.email.split('@')[0] : 'Administrator' %>
                    </h3>
                </div>
            </div>

            <div class="header-meta">
                <div class="date-badge">
                    <i class="far fa-calendar-check" style="color: var(--primary-color);"></i>
                    <span><%= new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                </div>
                <div style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--secondary-color), #334155); color: white; font-weight: 800; font-size: 0.95rem; box-shadow: var(--shadow-sm);">
                    <%= (typeof admin !== 'undefined' && admin && admin.email) ? admin.email.charAt(0).toUpperCase() : 'A' %>
                </div>
            </div>
        </header>

        <!-- Page Content Wrapper -->
        <div class="content-wrapper">